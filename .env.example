# ---------------------------------------------------------------------------
# Microsoft Foundry (recommended)
# ---------------------------------------------------------------------------
# Endpoint of the Foundry resource, without the /openai/v1 suffix.
AZURE_API_BASE="https://<your-resource>.services.ai.azure.com"
# API key of the Foundry resource.
AZURE_API_KEY="<your-foundry-api-key>"
# "preview" / "v1" / "latest" use the OpenAI compatible v1 API surface.
# Set a dated value (e.g. 2025-02-01-preview) only for legacy deployments.
# AZURE_API_VERSION="preview"

# ---------------------------------------------------------------------------
# OpenAI (used when AZURE_API_BASE is not set)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY="sk-..."
# OPENAI_BASE_URL="https://api.openai.com/v1"

# ---------------------------------------------------------------------------
# Claude -> GPT model mapping (deployment names on Foundry)
# ---------------------------------------------------------------------------
# BIG_MODEL="gpt-5"          # claude opus 5
# MIDDLE_MODEL="gpt-5"       # claude sonnet 5
# SMALL_MODEL="gpt-5-mini"   # claude haiku 4.5

# ---------------------------------------------------------------------------
# Optional tuning
# ---------------------------------------------------------------------------
# Default reasoning effort: none | minimal | low | medium | high | xhigh
# REASONING_EFFORT="medium"
# Upper bound for max_tokens sent to the GPT deployment.
# MAX_OUTPUT_TOKENS="32768"
# Port the proxy listens on.
# PORT="8082"
